  "sources": [
    {
      "id": "H01",
      "title": "Borràs Matamoros, tesi, pp. 161–162 i 229–231",
      "file": "tesi doctoral.pdf",
      "use": "Guardiola esmentada entre els elements existents el 1780. Glorieta: rotonda, tres arcs de maó a migdia, cos rectangular annex i cúpula no construïda. La descripció de Jaubert es refereix a una visita de 1816: no és un inventari de 1800."
    },
    {
      "id": "H02",
      "title": "Reverté, inventari de les obres de 1794",
      "use": "La Glorieta no apareix esmentada expressament. No se li assigna una data exacta d'acabament a partir d'aquest inventari."
    },
    {
      "id": "H12",
      "title": "Turisme La Ràpita · Mirador de la Guardiola",
      "url": "https://turismelarapita.cat/es/interes/mirador-de-la-guardiola/",
      "use": "Torre documentada des de 1483 i artillada el 1575; planta quadrada, base atalussada i paredat. Els 113 m es refereixen al turó, no a l'alçària de la torre."
    },
    {
      "id": "PDC-MORO",
      "title": "Pobles de Catalunya: Torre del Moro I / Torre de Magin",
      "url": "https://www.poblesdecatalunya.cat/element.php?e=18383",
      "use": "Fitxa consultada 01/11/2026 i fotos aportades per Josep: planta rectangular, base atalussada, cantoneres de carreus, dos matacans i merlets. Datacio general XVI-XVII, amb propostes anteriors. No es un aixecament de 1800."
    }
  ],
